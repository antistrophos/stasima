# Stasima v1 — deployment config (flat TOML). Copy to stasima.toml and edit.
# Point the server at it with STASIMA_CONFIG=/path/to/stasima.toml.
# Any STASIMA_* env var overrides the matching key here.

git_dir   = "/path/to/stasima.git"   # absolute path to the bare repo (Windows: "C:\\path\\to\\stasima.git")
deployment_name = ""                     # your deployment's own name (shows in arrival, orientation, authenticator)
approvers = ["practitioner"]          # whose review lands canon
canon_ref = "refs/heads/main"

# Derived stores. Leave blank to default beside git_dir.
map_db   = ""                         # throwaway cache — rebuilds via reindex_from_git
audit_db = ""                         # TRUTH — back this up like the repo

committer_name  = "capstore"          # the bot identity on commits (provenance is the author trailer)
committer_email = "capstore@stasima.local"

# Embeddings: "stub" (offline dev, lexical proxy) or "local-server" (LM Studio / Ollama).
embed_backend = "stub"
embed_url     = "http://localhost:11434"  # Ollama default; LM Studio is usually :1234
embed_model   = "nomic-embed-text"
embed_dim     = 768
# Task prefixes — nomic is prefix-conditioned and ranks BADLY without these (verified live).
# Keep for nomic/mxbai/arctic-style models; set both to "" for models that don't use prefixes.
embed_doc_prefix   = "search_document: "
embed_query_prefix = "search_query: "

# Where the orientation renderer reads this deployment's practice sections from canon.
orientation_base = "technical/orientation"

# Airlock — TOTP two-phase remote approval (approving through an instance conversation).
# Provision with `admin totp-provision`; console `land` is unaffected. Floor must exceed the
# worst-case code lifetime (~90s) so no code obtained at staging survives to landing.
airlock_secret_path = ""    # blank -> totp.secret beside git_dir; server-side only, never in git
airlock_floor_s     = 120   # minimum review time between code 1 (stage) and code 2 (land)
airlock_ceiling_s   = 7200  # staged proposals auto-revert after this

# Transport. "stdio" (default): each MCP client spawns the server itself — simplest, on-box only.
# "http": ONE continuously-running server; clients connect to http://<host>:<port>/mcp
# (Claude Code: `claude mcp add --transport http stasima http://127.0.0.1:8787/mcp`).
# http binds are restricted to loopback or a Tailscale 100.x address — for other devices, run
# `tailscale serve --bg 8787` and connect via the tailnet HTTPS URL it prints. Nothing listens
# toward the open internet; auth for exposure beyond the tailnet is the OAuth door (below).
transport  = "stdio"
http_host  = "127.0.0.1"
http_port  = 8787
# http_allowed_hosts = ["yourbox.your-tailnet.ts.net"]   # extra Host values (e.g. a tailscale serve proxy)
# Stateless http: no transport sessions at all, so the service can restart under open bridges
# without terminating them (measured with bridge_smoke.py). Legacy clients' audit rows then read
# `session: stateless`. Recommended for a fleet service (OPERATIONS, "Stateless http").
# http_stateless = true
# The interpreter the cockpit starts the http service with — the service's own venv (the SDK
# upgrade must never land in the interpreter that runs an mcp-proxy bridge). Blank = the cockpit's.
# service_python = "C:/path/to/stasima-venv/Scripts/python.exe"

# Binding (process grain): "strict" (default when blank — a mismatched identity-claiming write
# refuses), "witness" (proceeds + stamps authored_via), "off". A SHARED http service must run
# "off" or be pinned with STASIMA_INSTANCE — the protocol has no per-conversation session to bind,
# and the server refuses to start a shared service that could learn (OPERATIONS, "Seat
# identity"). Env STASIMA_BINDING overrides this field.
# binding_mode = "strict"

# The OAuth door. Setting this turns the authorization server ON (discovery + DCR + PKCE + a
# bearer requirement on /mcp; the same TOTP that gates canon approves connectors — or approve
# from the cockpit console). https required unless loopback; the host is auto-added to
# http_allowed_hosts. Blank = no auth (loopback/tailnet trust).
# http_public_url = "https://yourbox.your-tailnet.ts.net"
# How many of the most recent land narratives canon_diff carries in full; older logs ride as
# pointers (a first pull of a grown canon otherwise carries every narrative). The response always
# states the split (logs_in_full / logs_as_pointers). 0 = all pointers.
# pull_logs_in_full = 8

# The join gate. A seat's first write to its perspective must be its ::1 state update; every other
# write is refused with the join call in the refusal until then (reads and the reconcile stay open).
# Seats with entries from before the gate are never gated. Set false only for a scratch server.
# join_gate = true

# Per-git-op timeout (s). A local git op is sub-second; a hang means contention, and this bounds it
# so it fails LOUD instead of hanging forever. 0 = auto: 2s stdio / 20s http. Raise for a huge corpus.
# The FIRST git op of each server process gets a one-time grace window (cold start: Windows scanning
# git.exe), so the tight steady-state value never false-fires on arrival.
# git_timeout = 0
